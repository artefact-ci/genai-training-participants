LLM_API_KEY=
MODELE=
MODELE_2=
# Module 2 (RAG) : modèle d'embedding via LiteLLM, par exemple text-embedding-3-small
MODELE_EMBEDDING=

# --- Module 2, recherche hybride et reranking ---
# Reranker : Cohere Rerank déployé sur Azure AI Foundry, appelé via LiteLLM.
# MODELE_RERANK = azure_ai/ suivi du nom du déploiement ; RERANK_API_BASE = l'adresse de la ressource (https://<ressource>.services.ai.azure.com)
MODELE_RERANK=
RERANK_API_KEY=
RERANK_API_BASE=

# --- Module 5 (facultatif) ---
# Langfuse Cloud (bonus du module 2, démonstration du module 3, module 5) : compte Hobby gratuit sur https://cloud.langfuse.com,
# puis Settings > API Keys. LANGFUSE_HOST = la région du projet : https://cloud.langfuse.com (Europe) ou https://us.cloud.langfuse.com (États-Unis)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Sépare plusieurs usages dans un même projet Langfuse (filtre « environment »), par exemple formation ou demo
# LANGFUSE_TRACING_ENVIRONMENT=
# Démo WhatsApp du formateur : voir 05_canaux_gouvernance/demos/demo1_whatsapp/README.md
# WA_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_VERIFY_TOKEN=
# META_APP_SECRET=
# IDENTITES={"2250700000000": "CLI-0002"}
# Formation : tout expéditeur inconnu est traité comme ce client (sans identification par numéro ni par /client).
# CLIENT_PAR_DEFAUT=CLI-0002
# Fichier des conversations du module 5 (par défaut : 05_canaux_gouvernance/service/conversations.db)
# CONVERSATIONS_DB=


# Paramètres pour le module 2 (RAG) : recherche hybride et reranking
